---
import Base from '../layouts/Base.astro';
import PostBody from '../components/PostBody.astro';
import { allPages, listed, permalink } from '../lib/site';

export async function getStaticPaths() {
  const front = await listed();
  return (await allPages()).map((page) => {
    const i = front.findIndex((p) => p.id === page.id);
    return {
      params: { slug: page.id },
      props: { page, higher: i >= 0 ? front[i + 1] : undefined, lower: i > 0 ? front[i - 1] : undefined },
    };
  });
}
const { page, higher, lower } = Astro.props;
---
<Base url={permalink(page)} description={page.data.description ?? ''}>
    <div class="post">
        <PostBody page={page} />
        {(higher || lower) && (
            <div class="pagination">
                <div class="pagination__title">
                    <span class="pagination__title-h">Thanks for reading! Read other posts?</span>
                    <hr />
                </div>
                <div class="pagination__buttons">
                    {higher && (
                        <span class="button previous">
                            <a href={permalink(higher)}><span class="button__icon">←</span>&nbsp;<span class="button__text">{higher.data.title}</span></a>
                        </span>
                    )}
                    {lower && (
                        <span class="button next">
                            <a href={permalink(lower)}><span class="button__text">{lower.data.title}</span>&nbsp;<span class="button__icon">→</span></a>
                        </span>
                    )}
                </div>
            </div>
        )}
    </div>
</Base>
